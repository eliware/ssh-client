{
    "name": "@eliware/ssh-client",
    "type": "module",
    "version": "2.1.0",
    "description": "An ESM-first Node.js SSH client with secure host verification, reusable connections, command execution, interactive shells, and SFTP transfers.",
    "types": "index.d.ts",
    "files": [
        "index.mjs",
        "src",
        "index.d.ts",
        "README.md",
        "LICENSE",
        "examples"
    ],
    "exports": {
        ".": {
            "import": "./index.mjs",
            "types": "./index.d.ts"
        }
    },
    "scripts": {
        "test": "eliware-test",
        "lint": "eliware-test --lint",
        "typecheck": "tsc --project tsconfig.json",
        "pack": "npm pack --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/ssh-client.git"
    },
    "keywords": [
        "ssh",
        "ssh-client",
        "nodejs",
        "private-key",
        "esm",
        "typescript",
        "automation",
        "remote-exec",
        "sequential-commands"
    ],
    "author": "Eli Sterling, eliware.org <eli@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/ssh-client/issues"
    },
    "homepage": "https://github.com/eliware/ssh-client#readme",
    "devDependencies": {
        "@eliware/test": "^6.0.1",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@eliware/ssh2": "1.17.0"
    },
    "prettier": {
      "printWidth": 100,
      "tabWidth": 2,
      "useTabs": false,
      "semi": true,
      "singleQuote": false,
      "quoteProps": "as-needed",
      "jsxSingleQuote": false,
      "trailingComma": "all",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "arrowParens": "always",
      "proseWrap": "preserve",
      "endOfLine": "lf"
    }
}
