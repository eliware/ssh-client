{
    "name": "@eliware/ssh-client",
    "type": "module",
    "version": "1.2.0",
    "description": "A simple, ESM-first SSH client for Node.js with key or password authentication, host verification, transfers, and sequential command execution.",
    "types": "index.d.ts",
    "files": [
        "index.mjs",
        "src",
        "index.d.ts",
        "README.md",
        "LICENSE",
        "examples"
    ],
    "exports": {
        ".": {
            "import": "./index.mjs",
            "types": "./index.d.ts"
        }
    },
    "scripts": {
        "test": "eliware-test",
        "lint": "eliware-test --lint",
        "typecheck": "tsc --project tsconfig.json",
        "pack": "npm pack --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/ssh-client.git"
    },
    "keywords": [
        "ssh",
        "ssh-client",
        "nodejs",
        "private-key",
        "esm",
        "typescript",
        "automation",
        "remote-exec",
        "sequential-commands"
    ],
    "author": "Eli Sterling, eliware.org <eli@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/ssh-client/issues"
    },
    "homepage": "https://github.com/eliware/ssh-client#readme",
    "devDependencies": {
        "@eliware/test": "^2.0.0",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "ssh2": "^1.16.0"
    }
}
